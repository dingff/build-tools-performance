{
  "name": "performance-compare",
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iconify-icons/material-symbols": "^1.2.59",
    "@iconify/react": "^6.0.2",
    "@material-ui/icons": "^4.11.3",
    "@mui/icons-material": "^9.4.0",
    "@tabler/icons-react": "^3.46.0",
    "antd": "^6.6.2",
    "quickchart-js": "^3.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@farmfe/cli": "^1.0.5",
    "@farmfe/core": "^1.7.11",
    "@farmfe/plugin-react": "^1.2.6",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@rsbuild/core": "^2.2.3",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rspack/cli": "^2.2.2",
    "@rspack/core": "^2.2.2",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@unpackjs/core": "^4.9.0",
    "@unpackjs/plugin-react": "^4.7.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-loader": "^10.1.1",
    "cross-env": "^10.1.0",
    "esbuild-loader": "^4.5.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.0",
    "gzip-size": "^7.0.0",
    "html-webpack-plugin": "^5.6.8",
    "markdown-table": "^3.0.4",
    "next": "^16.3.4",
    "picocolors": "^1.1.1",
    "puppeteer": "^24.43.1",
    "react-refresh": "^0.18.0",
    "rslog": "^2.3.0",
    "string-width": "^8.2.2",
    "swc-loader": "^0.2.7",
    "tree-kill": "^1.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^5.2.6"
  },
  "scripts": {
    "benchmark": "node benchmark.mjs",
    "benchmark:debug": "cross-env DEBUG=true WARMUP_TIMES=0 RUN_TIMES=1 node benchmark.mjs",
    "clean": "rm -rf ./node_modules/.cache && rm -rf ./node_modules/.vite && rm -rf ./node_modules/.farm && rm -rf ./node_modules/.unpack",
    "start:farm": "farm start",
    "build:farm": "farm build",
    "start:vite": "node ./node_modules/vite/bin/vite.js",
    "start:vite:full-bundle": "node ./node_modules/vite/bin/vite.js --experimentalBundle",
    "build:vite": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "start:webpack": "cross-env NODE_ENV=development webpack serve --mode development",
    "build:webpack": "cross-env NODE_ENV=production webpack build --mode production",
    "start:rspack": "cross-env NODE_ENV=development rspack serve",
    "build:rspack": "cross-env NODE_ENV=production rspack build",
    "start:rsbuild": "rsbuild dev",
    "build:rsbuild": "rsbuild build",
    "start:unpack": "unpack dev",
    "start:unpack:prebundle": "cross-env PREBUNDLE=true unpack dev",
    "start:unpack:experiments-css": "cross-env EXPERIMENTS_CSS=true unpack dev",
    "build:unpack": "unpack build",
    "start:next": "node scripts/changeNextEntry.mjs && cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev --port 3200",
    "build:next": "node scripts/changeNextEntry.mjs && cross-env NODE_OPTIONS=--max-old-space-size=8192 next build"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "browserslist": [
    "chrome >= 110",
    "edge >= 110",
    "firefox >= 115",
    "safari >= 17"
  ]
}
